{
  "name": "fotosortierer",
  "version": "0.3.0",
  "description": "Fotos und Videos per Tastendruck sortieren",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite build && electron .",
    "build": "vite build",
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.cjs && node --experimental-strip-types --no-warnings --test test/*.test.mjs",
    "test:e2e": "vite build && node test/e2e/run.cjs",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "author": "SlimBit Apps",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "zustand": "^5.0.15"
  },
  "productName": "Fotosortierer",
  "private": true,
  "build": {
    "appId": "de.fotosortierer.app",
    "productName": "Fotosortierer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "electron/core/heic-worker.cjs",
      "node_modules/heic-convert/**",
      "node_modules/heic-decode/**",
      "node_modules/libheif-js/**",
      "node_modules/jpeg-js/**",
      "node_modules/pngjs/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Fotosortierer-Windows-portable.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Fotosortierer",
      "installerLanguages": [
        "de_DE",
        "en_US"
      ],
      "multiLanguageInstaller": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Fotosortierer-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.photography",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Fotosortierer-Mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "appx": {
      "identityName": "FOTOSORTIERER.PLATZHALTER",
      "publisher": "CN=PLATZHALTER-PUBLISHER-ID",
      "publisherDisplayName": "Hersteller-Name",
      "displayName": "Fotosortierer",
      "applicationId": "Fotosortierer",
      "languages": [
        "de-DE",
        "en-US"
      ],
      "backgroundColor": "#14161a",
      "artifactName": "Fotosortierer-Store.${ext}"
    },
    "dmg": {
      "title": "Fotosortierer",
      "background": "build/background.png",
      "iconSize": 110,
      "window": {
        "width": 660,
        "height": 420
      },
      "contents": [
        {
          "x": 170,
          "y": 215,
          "type": "file"
        },
        {
          "x": 490,
          "y": 215,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "compression": "maximum",
    "electronLanguages": [
      "de",
      "en",
      "en-US",
      "en-GB",
      "fr",
      "es",
      "it"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/slimbitapps/fotosortierter.git"
  }
}
