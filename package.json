{
  "name": "fotosortierer",
  "version": "0.1.0",
  "description": "Fotos und Videos per Tastendruck sortieren",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite build && electron .",
    "build": "vite build",
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.cjs",
    "test:e2e": "vite build && node test/e2e/run.cjs",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "author": "Johannes",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "zustand": "^5.0.15"
  },
  "productName": "Fotosortierer",
  "private": true,
  "build": {
    "appId": "de.fotosortierer.app",
    "productName": "Fotosortierer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "electron/core/heic-worker.cjs",
      "node_modules/heic-convert/**",
      "node_modules/heic-decode/**",
      "node_modules/libheif-js/**",
      "node_modules/jpeg-js/**",
      "node_modules/pngjs/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Fotosortierer-${version}-Windows-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Fotosortierer",
      "artifactName": "Fotosortierer-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.photography",
      "artifactName": "Fotosortierer-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    }
  }
}
